{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/trust/evidence-record-intake.v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "harness.planeon.ai/v1alpha1"},
    "kind": {"const": "EvidenceRecord"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^evidence\\.guardrail\\.[0-9a-f]{32}$"},
        "version": {"const": "1.0.0"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "recordState", "axis", "result", "subject", "producer", "producerAuthority", "evidenceDigest", "provenanceDigest", "collectedAt", "validUntil", "controlIds", "campaignGenerated"],
      "properties": {
        "organizationId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
        "recordState": {"const": "RECEIVED"},
        "axis": {"const": "SECURITY"},
        "result": {"enum": ["PASS", "WARN", "FAIL"]},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "digest"],
          "properties": {
            "kind": {"const": "resource.guardrail-profile"},
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {"type": {"const": "SYSTEM"}, "id": {"const": "system.guardrail-service"}}
        },
        "producerAuthority": {"const": "PLATFORM"},
        "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provenanceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "collectedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "validUntil": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "controlIds": {"const": ["control.guardrail-evaluation"]},
        "campaignGenerated": {"const": false}
      }
    }
  }
}
