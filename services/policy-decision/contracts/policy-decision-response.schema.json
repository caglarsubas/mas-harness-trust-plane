{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/trust/v1alpha1/policy-decision-response.schema.json",
  "title": "PolicyDecisionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "organizationId", "subjectId", "requestDigest", "policyDigest", "allowed", "reasonCode", "obligations", "evaluatedAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/policy-decision/v1alpha1"},
    "decisionId": {"type": "string", "pattern": "^decision\\.[a-f0-9]{32}$"},
    "organizationId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "allowed": {"type": "boolean"},
    "reasonCode": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "obligations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
