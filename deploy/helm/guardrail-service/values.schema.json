{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "existingSecrets", "readinessOrganizationId", "service", "resources", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 5},
    "image": {"$ref": "#/$defs/image"},
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oidcRegistry", "profileKeyset", "activeProfiles", "database"],
      "properties": {
        "oidcRegistry": {"$ref": "#/$defs/name"},
        "profileKeyset": {"$ref": "#/$defs/name"},
        "activeProfiles": {"$ref": "#/$defs/name"},
        "database": {"$ref": "#/$defs/name"}
      }
    },
    "readinessOrganizationId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$", "maxLength": 128},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {"requests": {"$ref": "#/$defs/resources"}, "limits": {"$ref": "#/$defs/resources"}}
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressNamespaceLabels", "databaseNamespaceLabels", "databasePodLabels", "databasePort"],
      "properties": {
        "enabled": {"const": true},
        "ingressNamespaceLabels": {"$ref": "#/$defs/labels"},
        "databaseNamespaceLabels": {"$ref": "#/$defs/labels"},
        "databasePodLabels": {"$ref": "#/$defs/labels"},
        "databasePort": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "minLength": 1, "maxLength": 63},
    "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {"repository": {"$ref": "#/$defs/repository"}, "digest": {"$ref": "#/$defs/digest"}, "pullPolicy": {"enum": ["IfNotPresent", "Never"]}}
    },
    "labels": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^(?:[a-z0-9](?:[-a-z0-9_.]*[a-z0-9])?)(?:/[a-z0-9](?:[-a-z0-9_.]*[a-z0-9])?)?$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 63}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "string", "pattern": "^[1-9][0-9]*m?$"}, "memory": {"type": "string", "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi)$"}}
    }
  }
}
